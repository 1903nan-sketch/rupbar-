{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RupBar",
  "version": "0.5.0",
  "identifier": "com.ruptix.rupbar",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RupBar",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ruptix",
    "copyright": "© Ruptix",
    "category": "Business",
    "shortDescription": "Gestão para bares, adegas e tabacarias",
    "longDescription": "RupBar: comandas, estoque por ml e g, caixa, cozinha, TV de retirada, narguilés e sincronização com o painel online. Funciona sem internet.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/server/": "server/",
      "resources/rupbar-service.exe": "rupbar-service.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
