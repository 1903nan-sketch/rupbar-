{
  "name": "@rupbar/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Servidor local do RupBar: API, tempo real, impressão, TV e sincronização (offline-first).",
  "scripts": {
    "dev": "tsx watch src/main.ts --data-dir ./.data",
    "start": "tsx src/main.ts",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@rupbar/core": "workspace:*",
    "fastify": "^5.12.5",
    "multicast-dns": "^7.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
