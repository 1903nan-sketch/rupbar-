<?xml version="1.0" encoding="utf-8"?>
<!-- Banner da tela inicial do Android TV (320×180). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/icon_bg_start"
                android:endColor="@color/icon_bg_end" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item
        android:width="112dp"
        android:height="112dp"
        android:drawable="@drawable/brand_mark"
        android:gravity="center" />
</layer-list>
