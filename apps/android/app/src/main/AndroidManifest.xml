<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Descobrir a rede Wi-Fi (IP e prefixo) e vincular o app a ela. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- window.RupBarAndroid.vibrate() ao enviar pedidos. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RupBar">

        <!-- Tela inicial: encontra o PC do bar (último endereço, varredura da rede ou digitação). -->
        <activity
            android:name=".ConnectActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.RupBar.Connect"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Interface do garçom (http://<ip>:<porta>/m) em tela cheia. -->
        <activity
            android:name=".WebAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
