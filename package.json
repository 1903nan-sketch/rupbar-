{
  "name": "rupbar",
  "private": true,
  "version": "0.1.0",
  "description": "RupBar — sistema de gestão para bares, adegas e tabacarias. by Ruptix",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@rupbar/desktop run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:server": "pnpm --filter @rupbar/server dev",
    "dev:ui": "pnpm --filter @rupbar/local-ui dev",
    "dev:panel": "pnpm --filter @rupbar/owner-panel dev",
    "bundle:server": "pnpm --filter @rupbar/local-ui build && pnpm --filter @rupbar/server bundle"
  }
}
